# ============================================================
#  VARIABLES DE ENTORNO — DESARROLLO LOCAL
# ============================================================
# Este archivo lo carga Vite automáticamente cuando se ejecuta
# `npm run dev`. Sus valores tienen prioridad sobre los del .env.
#
# Como contiene únicamente valores PÚBLICOS (URL del backend local
# y claves "publishable" de Stripe), es seguro subirlo al repositorio.
#
# Nada de claves "secret" o "service role" aquí — esas viven
# exclusivamente en el backend.
# ============================================================

# URL absoluta al backend que corre en local (Fastify en puerto 3000).
# El api/index.js construye las peticiones como `${BASE}/api/...`,
# así que aquí ponemos la URL completa para apuntar a otro origen.
VITE_API_URL=http://localhost:3000

# Configuración de Supabase para acceso desde el navegador
# (subida de imágenes de productos al bucket de Storage).
VITE_SUPABASE_URL=https://yiuigqnbwhaahmmlhhls.supabase.co
VITE_SUPABASE_STORAGE_BUCKET=product-images

# Clave publishable de Stripe en modo TEST.
# Es pública por diseño — viaja en el bundle JS al navegador.
# Solo permite crear PaymentMethods, nunca mover dinero real.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51TTJTrBWh2msQeWtRDGWHv97nXnEamL2q4rCCApatU1Ov43MFolzZTlJG9C5bjrp3TMOSwEFMLsyC4AbcjwxlCr500L4qtk4n3
